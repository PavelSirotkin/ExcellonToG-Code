# Python
__pycache__/
.pytest_cache
*.py[cod]
*$py.class
*.so
*.egg-info/

# Dist/build artifacts — никогда не коммитим, релизы публикуем через
# GitHub Releases (а не как файлы в git). Раньше здесь стояло !dist/*.*,
# что инвертировало исключение и приглашало добавить exe (~12 МБ) в репо.
build/
dist/

# Virtual environments
venv/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project-specific
.claude/
.qwen/
#*.spec
CHANGES.md
RELEASE_NOTES.md
AUDIT_REPORT.md

# Локальные настройки пользователя (язык/тема). Файл создаётся
# приложением при первом запуске; коммитить личные предпочтения
# в репо не нужно — это вызывает merge-конфликты у каждого
# разработчика. Если ты уже добавил его в индекс ранее, выполни
# вручную:  git rm --cached app_settings.json
app_settings.json

# Generated files (keep templates, ignore runtime data)
!tool_base.json
!gcode_params.json

# Runtime logs
*.log
