  "tt.btn_open_excellon": "Load Excellon file with round holes.\nSupported formats: .DRL, .TXT\nThe file contains hole coordinates and diameters.",
  "tt.btn_open_slots": "Load SlotHoles file with oval holes.\nFormat: start and end point of each slot.\nSlots are milled, not drilled.",
  "tt.btn_open_gerber": "Load board outline in Gerber format.\nUsed for cutting the board along its outline.\nUsually a file with _Profile suffix or .GKO extension.",
  "tt.entry_safe_z": "Safe height for rapid moves.\nThe tool rises to this height between operations.\nTypical value: 5 mm",
  "tt.entry_drill_z": "Drilling depth (NEGATIVE!).\nFor a 1.6 mm board use -1.8 mm.\nA 0.2 mm reserve guarantees through-drilling.",
  "tt.entry_feed_rate": "Drill plunge feed rate.\nFor PCB: 100-200 mm/min\nFor aluminum: 50-100 mm/min",
  "tt.entry_mill_feed": "Slot and outline milling feed.\nHorizontal end mill movement in material.\nTypical value: 150-300 mm/min",
  "tt.entry_rapid_rate": "Rapid move speed (G0).\nQuick movement between points.\nTypical value: 1000-3000 mm/min",
  "tt.entry_park_z": "Park height for tool change.\nAfter each tool the machine parks at (0,0,Z).\nTypical value: 20-50 mm",
  "tt.mode_toggle": "Switch between Simple and Pro modes.\nSimple: basic parameters for quick start.\nPro: full control with tool database.",
  "tt.btn_gen_drilling": "Generate G-code for round holes only.\nUses G81 (drilling cycle) command.\nOptimizes drilling order to save time.",
  "tt.btn_gen_milling": "Generate G-code for slots only.\nMills oval holes with linear movements.\nRequires a loaded SlotHoles file.",
  "tt.btn_gen_combined": "Combined G-code: drilling + milling.\nFirst all holes, then all slots.\nConvenient for full board processing.",
  "tt.btn_gen_outline": "G-code for cutting the board along its outline.\nRequires a loaded Gerber outline file.\nSupports holding tabs.",
  "tt.btn_visualize": "Open the path visualization window.\nShows tool path in 3D.\nLets you inspect the G-code before running.",
  "tt.btn_statistics": "Show project statistics.\nBoard size, hole count,\npath length and approximate processing time.",
  "tt.btn_help": "Open the help system.\nDetailed documentation for all features.\nHotkey: F1",
  "tt.entry_outline_tool_diameter": "End mill diameter for outline cutting.\nThe path is automatically offset outward\nby half the diameter.\nTypical value: 1–3 mm",
  "tt.entry_outline_depth_per_pass": "Material removal depth per Z pass.\nThe number of passes down to drill_z is\ncalculated automatically.\nFor 1.6 mm FR-4: 0.4–0.8 mm",
  "tt.entry_outline_n_tabs": "Number of holding tabs.\nTabs hold the board in the workpiece\nduring the final cut.\nTypical value: 2–6",
  "tt.entry_outline_tab_width": "Tab length along the board outline.\nTabs are broken off after cutting.\nTypical value: 2–5 mm",
  "tt.entry_outline_tab_height": "Tab height — Z under-cut.\nThickness of material left under the mill\nin the tab area.\nTypical value: 0.5–1 mm",
  "tt.combo_outline_direction": "Outline traversal direction.\nCCW (counter-clockwise) — climb for the outer outline,\nbetter edge quality.\nCW (clockwise) — conventional, more stable\non machines with backlash.",
  "tt.canvas": "Visualization workspace.\nMouse wheel: zoom\nLMB + drag: pan\nDouble click: auto-zoom",

